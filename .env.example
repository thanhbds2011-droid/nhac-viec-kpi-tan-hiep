# VERCEL → Project Settings → Environment Variables (KHÔNG commit giá trị thật)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SHARED_SECRET=RANDOM_LONG_HEX_SECRET_IDENTICAL_TO_SCRIPT_PROPERTIES
PUSH_ID_SECRET=ANOTHER_RANDOM_LONG_SECRET_PRIVATE_TO_VERCEL

# YC-005 – Optional: without key, all existing functions work; live cross-device disabled
ABLY_API_KEY=YOUR_ABLY_APP_KEY_ID:YOUR_ABLY_PRIVATE_SECRET
